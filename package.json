{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "classmanager-monorepo",
    "version": "3.0.0",
    "private": true,
    "workspaces": [
        "frontend"
    ],
    "scripts": {
        "backend:dev": "php artisan serve --host=127.0.0.1 --port=8001",
        "frontend:dev": "npm run dev --workspace frontend",
        "dev": "concurrently --kill-others --names backend,frontend --prefix-colors blue,magenta \"npm:backend:dev\" \"npm:frontend:dev\"",
        "build": "npm run build --workspace frontend",
        "lint": "npm run lint --workspace frontend"
    },
    "devDependencies": {
        "concurrently": "^9.0.1"
    }
}
